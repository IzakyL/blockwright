    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@izakyl/blockwright-test": "0.1.0-alpha.0"
  },
  "description": "Model Context Protocol server for Blockwright Minecraft automation",
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/IzakyL/blockwright#readme",
  "bugs": {
    "url": "https://github.com/IzakyL/blockwright/issues"
