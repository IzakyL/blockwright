  "license": "MIT",
  "type": "module",
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "blockwright-mcp": "dist/main.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IzakyL/blockwright.git",
